# iTired - Конфигурация

# Секретный ключ для сессий (измените на случайную строку)
SECRET_KEY=itired-super-secret-key-change-this-in-production

# База данных (по умолчанию SQLite)
DATABASE_URL=sqlite:///itired.db

# === GOOGLE OAUTH ===
# Получите в Google Cloud Console: https://console.cloud.google.com/
# 1. Создайте проект
# 2. APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Application type: Web application
# 4. Add authorized redirect URI: http://localhost:5001/auth/google/callback
GOOGLE_CLIENT_ID=1092184566844-3k5vrm8td96hmmk4jp6nkptuokip7aoi.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback

# === DISCORD RICH PRESENCE ===
# Создайте webhook в Discord канале:
# 1. Настройки сервера > Интеграции > Webhooks > Новый webhook
# 2. Скопируйте URL webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1490787549235515563/xpvZMoxR656p-9Pq38GLELAKG5KOnb1PlICuLwKLSe_p30Q4lLD-xu4KtrvKS_I85lKS

# === EMAIL (для верификации) ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# === SOUNDCLOUD ===
# Каждый пользователь вводит свой client_id в профиле
# Получить client_id: https://soundcloud.com/discover → DevTools → Network → client_id

# Прокси для SoundCloud
# Варианты:
# 1. WARP: https://cloudflare.com/cdn-cgi/access/ips (бесплатный аккаунт Cloudflare)
# 2. Прокси-сервер: http://ip:port
# 3. Оставьте пустым если не нужен
SOUNDCLOUD_PROXY=

# Cloudflare WARP (если используете)
# Включите true если SoundCloud заблокирован
WARP_ENABLED=true
WARP_PROXY=socks5://127.0.0.1:40000

# === GENIUS API (для текстов песен) ===
# Получите токен на https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=rnUP1lMGXgSK7rnZmttcNa8iNyUCjUr4BE7mjPwRRSt2zC6cfT_i2PfrKfV1IWFs
