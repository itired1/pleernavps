# iTired - Production Configuration (VPS)

# === SECRET ===
SECRET_KEY=change-this-to-random-string

# === DATABASE (если используешь PostgreSQL) ===
DATABASE_URL=postgresql://user:password@localhost:5432/itired

# === REDIS (обязательно для кэша) ===
CACHE_REDIS_URL=redis://localhost:6379/0

# === S3 / Cloud Storage (Yandex Cloud / Cloudflare R2) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ru-central1
AWS_S3_ENDPOINT=
CDN_URL=

# === EMAIL ===
MAIL_USERNAME=
MAIL_PASSWORD=

# === GOOGLE OAUTH ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === DISCORD ===
DISCORD_WEBHOOK_URL=